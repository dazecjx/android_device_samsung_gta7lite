#!/usr/bin/env python3
"""touch 的替代实现。

本环境的 seccomp 策略会拒绝 utimensat 携带非 NULL timespec 的调用
（GNU touch / cp -p / install -p 全部报 EPERM "不允许的操作"），
但 utimensat(NULL) 是放行的。这里统一用 os.utime(path, None)。
"""
import os
import sys

files = []
nocreate = False
for a in sys.argv[1:]:
    if a == '-c' or a == '--no-create':
        nocreate = True
    elif a.startswith('-'):
        continue
    else:
        files.append(a)

for f in files:
    if not os.path.exists(f):
        if nocreate:
            continue
        d = os.path.dirname(f)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        open(f, 'a').close()
    try:
        os.utime(f, None)
    except OSError:
        pass
sys.exit(0)
